<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DesktopApplication</RootNamespace>
    <AssemblyName>DesktopApplication</AssemblyName>
    <Version>1.0.0</Version>
    <Product>DesktopApplication</Product>
    <Description>Windows desktop application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopApplication.Core\DesktopApplication.Core.csproj" />
  </ItemGroup>

</Project>
