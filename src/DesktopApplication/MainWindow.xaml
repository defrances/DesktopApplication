<Window x:Class="DesktopApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="640"
        Width="960"
        MinHeight="520"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBackground}"
                Padding="20,10">
            <TextBlock Text="{Binding Status}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"/>
        </Border>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,24"/>

                    <TextBlock Text="SYSTEM" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="User" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding SystemInformation.UserName}" FontSize="16" Margin="0,0,0,12"/>

                    <TextBlock Text="Computer" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding SystemInformation.MachineName}" FontSize="16" Margin="0,0,0,12"/>

                    <TextBlock Text="Operating system" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding SystemInformation.OperatingSystem}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Runtime" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding SystemInformation.Framework}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Architecture" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding SystemInformation.ProcessArchitecture}" FontSize="16"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Notes" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Local notes are stored in AppData and stay on this computer."
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,16"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource CardBackground}"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}"
                             BorderThickness="0"
                             Padding="12"
                             FontSize="14"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Check vendor bulletin"
                                Command="{Binding CheckBulletinCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"/>
                        <Button Content="Save notes"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
