<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>HostApplication</RootNamespace>
    <AssemblyName>HostApplication</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Host Application</Product>
    <Description>Windows host application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostApplication.Core\HostApplication.Core.csproj" />
  </ItemGroup>

</Project>
